# Copy to .env.local for local development. None of these are required to
# run the site — every integration degrades gracefully without them (see
# README.md "Environment variables" section).

# Forces a specific event phase instead of computing it from the current
# date and config/event.ts. Useful for previewing the site as it will look
# in a different phase. One of: announced | registration | closed | live | post
PHASE_OVERRIDE=registration

# Volunteer sign-up form (app/api/volunteer). Without these the form still
# works but does not forward submissions anywhere.
VOLUNTEER_WEBHOOK_URL=
VOLUNTEER_MAKE_WEBHOOK_URL=

# Weight-update form (app/api/weight). Same graceful-degradation behaviour.
WEIGHT_WEBHOOK_URL=

# Supabase — the system of record for registrations (supabase/migrations),
# and storage for athlete face photos (Excire Photo tagging). Without these,
# /api/register still works: it forwards to Make/Sheets only (the old
# behaviour) and skips the face-photo upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Checkout Sessions are created server-side (app/api/register) with
# dynamic line items (entry tier + optional premium media), replacing the
# old static Payment Links. Without STRIPE_SECRET_KEY, registration still
# completes in "demo" mode: no real charge, straight to the thank-you page.
STRIPE_SECRET_KEY=
# Needed only by app/api/stripe/webhook — the signing secret for a webhook
# registered in the Stripe dashboard, listening for
# checkout.session.completed. Marks a registration "paid" and sends the
# payment-confirmation email.
STRIPE_WEBHOOK_SECRET=

# Resend — registration-received and payment-confirmed emails
# (lib/email.ts). Needs a verified sending domain (e.g. sbdnext.hu) in the
# Resend dashboard first. Without RESEND_API_KEY, emails are silently
# skipped (registration/payment still succeed).
RESEND_API_KEY=
RESEND_FROM_EMAIL="SBD Next <nevezes@sbdnext.hu>"
